[Unit]
Description=Lindm explicit database migration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=lindmd-migrate
Group=lindmd-migrate
LoadCredential=database-url:/etc/lindm/migrate/database-url
ExecStart=/usr/bin/lindmd migrate -config /etc/lindm/migrate/server.json -database-url-credential database-url
TimeoutStartSec=6min
UMask=0077
MemorySwapMax=0
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
