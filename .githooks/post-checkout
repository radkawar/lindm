#!/bin/sh
set -eu
# git recreates the files a checkout changes, writable; make the shared main
# checkout's tracked files read-only again (go run ./cmd/dev protect).
# Private worktrees, including one git worktree add just created, stay
# writable.
[ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] || exit 0
exec make --no-print-directory protect
