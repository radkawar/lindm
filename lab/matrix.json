      "capabilities": ["inventory"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "inspect"
    },
    {
      "name": "enroll-from-console",
      "title": "Enroll from console",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "enroll-from-console"
    },
    {
      "name": "provision-cloud-init",
      "title": "Provision: cloud-init",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "provision-cloud-init"
    },
    {
      "name": "provision-autoinstall",
      "title": "Provision: Ubuntu autoinstall",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "provision-autoinstall"
    },
    {
      "name": "provision-kickstart",
      "title": "Provision: Kickstart",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "provision-kickstart"
    },
    {
      "name": "provision-autoyast",
      "title": "Provision: AutoYaST",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "provision-autoyast"
    },
    {
      "name": "airgap",
      "title": "Air-gap bundle",
      "capabilities": ["lifecycle", "self-update", "advisories"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "airgap"
    },
    {
      "name": "lifecycle",
      "title": "Lifecycle",
      "capabilities": ["lifecycle"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "lifecycle",
      "args": ["-local-authority"]
    },
    {
      "name": "dispatch",
      "title": "Dispatch",
      "capabilities": ["dispatch"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "dispatch",
      "args": ["-local-authority"]
    },
    {
      "name": "resources",
      "title": "Resources",
      "capabilities": ["packages", "accounts", "sysctl", "definitions", "password", "firewall"],
      "capabilityKinds": true,
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "resources",
      "args": ["-phase=connected", "-allow-network", "-local-authority", "-kinds=files"]
    },
    {
      "name": "services",
      "title": "Services",
      "capabilities": ["dispatch"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "services"
    },
    {
      "name": "encrypted",
      "title": "Encryption",
      "capabilities": ["encryption"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "device-actions",
      "args": ["-scenario=encryption"]
    },
    {
      "name": "tpm-unattended-boots",
      "title": "TPM unattended boots",
      "capabilities": ["encryption"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "device-actions",
      "args": ["-scenario=encryption", "-encryption-phase=tpm", "-tpm-boots=30"],
      "secureBoot": true,
      "tpm": true
    },
    {
      "name": "device-actions",
      "title": "Wipe/loss/lock",
      "capabilities": ["wipe", "report-loss", "lock"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "device-actions",
      "args": ["-scenario=wipe", "-wipe-phase=live-actions"]
    },
    {
      "name": "recovery-sanitize",
      "title": "Recovery sanitize",
      "capabilities": ["recovery-sanitize"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "device-actions",
      "args": ["-scenario=wipe", "-wipe-phase=recovery-nvme"],
      "secureBoot": true,
      "minimumRevision": "9b4e6f5fbf84aec197ab6922026d9be93d1da6b2"
    },
    {
      "name": "self-update",
      "title": "Self-update",
      "capabilities": ["self-update"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "updates"
    },
    {
      "name": "assistance",
      "title": "Assistance",
      "capabilities": ["assistance"],
      "image": "MATRIX_IMAGE_ENCRYPTED_INSTALLER",
      "lane": "assistance"
    },
    {
      "name": "advisories",
      "title": "Advisories",
      "capabilities": ["advisories"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "advisories"
    },
    {
      "name": "os-update",
      "title": "OS update",
      "capabilities": ["os-update"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "resources",
      "args": ["-phase=connected", "-kinds=os-update", "-allow-network", "-local-authority"]
    },
    {
      "name": "release-upgrade",
      "title": "Release upgrade",
      "capabilities": ["release-upgrade"],
      "image": "MATRIX_IMAGE_CLOUD",
      "lane": "resources",
      "args": ["-phase=release-upgrade", "-allow-network", "-local-authority"]
    }
  ],
  "rollingRequalificationCells": [
    "inventory",
    "enroll-from-console",
    "provision-autoyast",
    "lifecycle",
    "dispatch",
    "resources",
    "services",
    "encrypted",
    "device-actions",
    "recovery-sanitize",
    "self-update",
    "assistance",
    "advisories",
    "os-update",
    "release-upgrade"
  ],
  "architectureArgs": {
    "x86_64": {
      "args": [
        "-firmware-code=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "-firmware-vars=/usr/share/OVMF/OVMF_VARS_4M.fd",
        "-firmware-package=ovmf",
        "-firmware-version=2024.02-2ubuntu0.10"
      ]
    },
    "aarch64": {
      "args": [
        "-firmware-code=/usr/share/AAVMF/AAVMF_CODE.secboot.fd",
        "-firmware-vars=/usr/share/AAVMF/AAVMF_VARS.fd",
        "-firmware-package=qemu-efi-aarch64",
        "-firmware-version=2024.02-2ubuntu0.10"
      ]
    }
  },
  "secureBootArgs": {
    "x86_64": {
      "args": ["-firmware-vars=/usr/share/OVMF/OVMF_VARS_4M.ms.fd", "-secure-boot"]
    },
    "aarch64": {
      "args": ["-firmware-vars=/usr/share/AAVMF/AAVMF_VARS.ms.fd", "-secure-boot"]
    }
  }
}
