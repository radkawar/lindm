          {
            "resourceId": "03c4ee8c-ddb3-55eb-bd66-60ac022e8b59",
            "desired": {
              "ref": {
                "kind": "RESOURCE_KIND_OS_UPDATE_POLICY",
                "canonicalKey": "system"
              },
              "osUpdate": {
                "selection": "UPDATE_SELECTION_SECURITY",
                "maintenance": {
                  "timeZone": "Europe/London",
                  "weekdays": [
                    "WEEKDAY_MONDAY",
                    "WEEKDAY_TUESDAY",
                    "WEEKDAY_WEDNESDAY",
                    "WEEKDAY_THURSDAY",
                    "WEEKDAY_FRIDAY",
                    "WEEKDAY_SATURDAY",
                    "WEEKDAY_SUNDAY"
                  ],
                  "localStartMinute": 120,
                  "durationMinutes": 120
                },
                "rebootPolicy": {
                  "mode": "OS_UPDATE_REBOOT_MODE_SCHEDULED",
                  "maxDelayMinutes": 360,
                  "notice": "Security updates require a restart. Save your work.",
                  "rebootWindow": {
                    "timeZone": "Europe/London",
                    "weekdays": [
                      "WEEKDAY_MONDAY",
                      "WEEKDAY_TUESDAY",
                      "WEEKDAY_WEDNESDAY",
                      "WEEKDAY_THURSDAY",
                      "WEEKDAY_FRIDAY",
                      "WEEKDAY_SATURDAY",
                      "WEEKDAY_SUNDAY"
                    ],
                    "localStartMinute": 300,
                    "durationMinutes": 120
                  },
                  "employeeDeferral": {
                    "maxDeferrals": 2,
                    "delayMinutes": 30
                  }
                }
              }
            },
            "ownership": {
              "mode": "OWNERSHIP_MODE_CREATE_ONLY",
              "release": "RELEASE_BEHAVIOR_RESTORE_OWNED"
            },
            "verification": {
              "maxAgeSeconds": 3600,
              "checks": ["HEALTH_CHECK_NATIVE_STATE"]
            }
          },
          {
            "resourceId": "f3beca00-8a31-5d41-aaad-96ffed27adf3",
            "desired": {
              "ref": {
                "kind": "RESOURCE_KIND_SYSCTL",
                "canonicalKey": "net.ipv4.conf.all.accept_redirects"
              },
              "sysctl": {
                "key": "net.ipv4.conf.all.accept_redirects",
                "value": "0",
                "persistent": true
              }
            },
            "ownership": {
