  "profiles": [
    {
      "id": "e54a8af0-53a9-5d50-bd8c-3b05c607554c",
      "spec": {
        "name": "Company baseline",
        "description": "Shared security baseline: a company login message, printing turned off, nightly security updates with a scheduled restart, a firewall that lets only SSH in, ICMP redirects ignored and local password rules. Devices can apply the firewall once firewall settings are set for all devices. The redirect settings and password rules take over settings every device already has, so rolling this profile out needs one approval. Password rules apply only on devices whose administrator turned on local password management on the device itself; other devices show them as blocked.",
        "resources": [
          {
            "resourceId": "5a8a187a-d28c-506e-ae52-0b65fbda3535",
            "desired": {
              "ref": {
                "kind": "RESOURCE_KIND_FIREWALL_ZONE",
                "canonicalKey": "db7f6c12-b34a-59d7-aae7-b5474fdc3f92"
              },
              "firewallZone": {
                "zoneId": "db7f6c12-b34a-59d7-aae7-b5474fdc3f92",
                "presence": "PRESENCE_PRESENT",
                "defaultIngress": "FIREWALL_VERDICT_DROP",
                "defaultEgress": "FIREWALL_VERDICT_ACCEPT",
                "rules": [
                  {
                    "ruleId": "c9e1439e-09fb-5ee4-8ed2-601ce6f4d88a",
                    "direction": "FIREWALL_DIRECTION_INPUT",
                    "family": "IP_FAMILY_IPV4",
                    "protocol": "IP_PROTOCOL_TCP",
                    "destinationPorts": [
                      {
                        "first": 22,
                        "last": 22
                      }
                    ],
                    "verdict": "FIREWALL_VERDICT_ACCEPT"
                  },
                  {
                    "ruleId": "1ff3b6f5-e9b8-5b53-ba1a-2a14c26062f8",
                    "direction": "FIREWALL_DIRECTION_INPUT",
                    "family": "IP_FAMILY_IPV6",
                    "protocol": "IP_PROTOCOL_TCP",
                    "destinationPorts": [
                      {
                        "first": 22,
                        "last": 22
                      }
                    ],
                    "verdict": "FIREWALL_VERDICT_ACCEPT"
                  }
                ]
              }
            },
            "ownership": {
              "mode": "OWNERSHIP_MODE_CREATE_ONLY",
              "release": "RELEASE_BEHAVIOR_RESTORE_OWNED"
            },
            "verification": {
              "maxAgeSeconds": 3600,
              "checks": ["HEALTH_CHECK_NATIVE_STATE"]
            }
          },
          {
            "resourceId": "be829bf4-93b4-514f-b6ef-6edf2f1dbeba",
            "desired": {
              "ref": {
                "kind": "RESOURCE_KIND_PASSWORD_POLICY",
                "canonicalKey": "system/local-auth"
              },
              "passwordPolicy": {
                "minLength": 14,
                "minClasses": 3,
                "historyCount": 10,
                "maxAgeDays": 90,
                "minAgeDays": 1,
                "warnDays": 14,
                "failureLimit": 5,
                "unlockAfterSeconds": 900,
                "enforceForRoot": true
              }
            },
            "ownership": {
              "mode": "OWNERSHIP_MODE_APPROVED_ADOPTION",
              "release": "RELEASE_BEHAVIOR_RESTORE_OWNED"
            },
            "verification": {
              "maxAgeSeconds": 3600,
              "checks": ["HEALTH_CHECK_NATIVE_STATE"]
            }
          },
          {
            "resourceId": "af3ad933-16a0-5375-96c8-280b34e57517",
            "desired": {
              "ref": {
                "kind": "RESOURCE_KIND_MANAGED_FILE",
                "canonicalKey": "/etc/motd.d/50-company"
              },
              "managedFile": {
                "path": "/etc/motd.d/50-company",
                "presence": "PRESENCE_PRESENT",
                "content": "Q29tcGFueSBtYW5hZ2VkIGRldmljZS4gQXV0aG9yaXplZCB1c2Ugb25seS4K",
                "mode": 420,
                "uid": 0,
                "gid": 0
              }
