{
  "name": "lindm",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Single-tenant Linux device management control plane and agent",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run lint:licenses && npm run format:check && npm run lint:docs && npm run lint:web && npm run typecheck:web",
    "build:web": "vite build --config web/vite.config.ts && npm run typecheck:web",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "lint:web": "eslint web/src --max-warnings=0 && node web/eslint/scan-css-colours.mjs",
    "acceptance:browser": "node web/acceptance/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\"",
    "lint:licenses": "node test/tooling/license-headers.mjs check",
    "audit:dependencies": "npm audit --audit-level=low",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "playwright": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "smol-toml": "1.9.0",
    "katex": "0.19.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
