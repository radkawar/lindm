{
  "name": "lindm",
  "private": true,
  "version": "0.0.0",
  "description": "Linux MDM product specification and engineering tooling",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint:docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\"",
    "audit:dependencies": "npm audit --audit-level=low",
    "test:tooling": "node --test test/tooling/*.test.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "lint-staged": "17.6.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.9"
  },
  "overrides": {
    "js-yaml": "5.4.1",
    "smol-toml": "1.9.0",
    "katex": "0.19.0"
  },
  "lint-staged": {
    "*.{md,json,jsonc,yaml,yml,js,mjs}": "prettier --check",
    "*.md": "markdownlint"
  }
}
